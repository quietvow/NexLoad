<Window x:Class="DOWN_MNG.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options &amp; Preferences" 
        Icon="Resources/app.ico"
        Height="440" Width="560" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- Tabbed Settings Body -->
        <TabControl Grid.Row="0" Margin="0,0,0,12">
            <!-- 1. GENERAL TAB -->
            <TabItem Header="General">
                <StackPanel Margin="10">
                    <GroupBox Header="Save To" Margin="0,0,0,10" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DownloadFolderTextBox" Padding="4,2" Margin="0,0,6,0" IsReadOnly="True" VerticalContentAlignment="Center"/>
                            <Button Content="Browse..." Grid.Column="1" Padding="12,2" Click="BrowseFolder_Click"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Automation &amp; System Integration" Padding="8">
                        <StackPanel>
                            <CheckBox x:Name="ClipboardMonitoringCheckBox" Content="Monitor clipboard for downloadable links" Margin="0,2,0,6"/>
                            <CheckBox x:Name="AutoStartCheckBox" Content="Start downloads immediately when added" Margin="0,2,0,6"/>
                            <CheckBox x:Name="PlaySoundCheckBox" Content="Play sound when download completes" Margin="0,2,0,6"/>
                            <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to System Tray" Margin="0,2,0,6"/>
                            <CheckBox x:Name="CloseToTrayCheckBox" Content="Close button minimizes to System Tray (Run in Background)" Margin="0,2,0,6"/>
                            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start NexLoad on Windows startup (Background)" Margin="0,2,0,8"/>
                            <Button Content="Setup Browser Extension (Chrome / Edge)..." Click="SetupExtension_Click" Padding="12,3" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- 2. CONNECTION TAB -->
            <TabItem Header="Connection">
                <StackPanel Margin="10">
                    <GroupBox Header="Download Streams" Margin="0,0,0,10" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Default connections per file:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ConnectionsComboBox" Grid.Column="1">
                                <ComboBoxItem Content="1 Connection"/>
                                <ComboBoxItem Content="2 Connections"/>
                                <ComboBoxItem Content="4 Connections"/>
                                <ComboBoxItem Content="8 Connections"/>
                                <ComboBoxItem Content="16 Connections"/>
                                <ComboBoxItem Content="32 Connections"/>
                            </ComboBox>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Speed Limiter" Padding="8">
                        <StackPanel>
                            <CheckBox x:Name="EnableSpeedLimitCheckBox" Content="Enable Speed Limiter globally" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Maximum download rate:" VerticalAlignment="Center"/>
                                <TextBox x:Name="SpeedLimitValTextBox" Grid.Column="1" Padding="4,2" Margin="0,0,6,0" Text="1024" VerticalContentAlignment="Center"/>
                                <TextBlock Text="KB/s" Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- 3. APPEARANCE & LANGUAGE TAB -->
            <TabItem Header="Appearance">
                <StackPanel Margin="10">
                    <GroupBox Header="Theme" Margin="0,0,0,10" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Color Theme:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1">
                                <ComboBoxItem Content="Light Theme"/>
                                <ComboBoxItem Content="Dark Theme"/>
                            </ComboBox>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Language / භාෂාව" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Display Language:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1">
                                <ComboBoxItem Content="English"/>
                                <ComboBoxItem Content="සිංහල (Sinhala)"/>
                            </ComboBox>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Width="75" Margin="0,0,8,0" Click="SaveButton_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="75" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
