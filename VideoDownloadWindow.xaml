<Window x:Class="DOWN_MNG.VideoDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media &amp; Video Grabber" 
        Height="440" Width="640" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. URL Input & Action Buttons -->
            <RowDefinition Height="*"/>    <!-- 2. Metadata & Quality Selection GroupBox -->
            <RowDefinition Height="Auto"/> <!-- 3. Save Destination -->
            <RowDefinition Height="Auto"/> <!-- 4. Action Buttons Footer -->
        </Grid.RowDefinitions>

        <!-- 1. URL Input & Grab Action -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="UrlTextBox" Grid.Column="0" 
                     Padding="4,2" Margin="0,0,6,0" VerticalContentAlignment="Center"
                     TextChanged="UrlTextBox_TextChanged"
                     KeyDown="UrlTextBox_KeyDown"/>

            <Button x:Name="PasteButton" Content="Paste" Grid.Column="1"
                    Padding="8,2" Margin="0,0,6,0" Click="PasteButton_Click"/>

            <Button Content="Batch Grab..." Grid.Column="2"
                    Padding="8,2" Margin="0,0,6,0" Click="BatchGrabButton_Click" ToolTip="Extract all video and media links from text"/>

            <Button x:Name="FetchButton" Content="Fetch Info" Grid.Column="3"
                    Padding="12,2" FontWeight="SemiBold" Click="FetchButton_Click"/>
        </Grid>

        <!-- 2. Rich Metadata & Format Selector GroupBox -->
        <GroupBox Grid.Row="1" Header="Video Information &amp; Quality" Margin="0,0,0,8" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Media Info (Thumbnail + Details) -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail Container -->
                    <Border Grid.Column="0" Height="80" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1">
                        <Grid>
                            <Image x:Name="ThumbnailImage" Stretch="UniformToFill"/>
                            <TextBlock x:Name="ThumbnailFallback" Text="Preview" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Details Column -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Title:" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="TitleTextBox" FontWeight="Bold" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PlatformBadgeText" Text="Video" FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBlock x:Name="AuthorTextBlock" Text="Channel" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="DurationTextBlock" Text="--:--" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" VerticalAlignment="Top" Margin="0,0,0,6"/>

                <!-- Format Selection Grid -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Select Download Quality and Format:" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FormatComboBox" Grid.Row="1" Height="26" DisplayMemberPath="Label" SelectionChanged="FormatComboBox_SelectionChanged"/>
                </Grid>

                <!-- Status Feedback Strip -->
                <TextBlock x:Name="StatusTextBlock" Grid.Row="2" 
                           Text="Enter a video link from YouTube, Facebook, or TikTok above and click Fetch Info." 
                           Foreground="{DynamicResource AccentPrimary}" Margin="0,8,0,0"/>
            </Grid>
        </GroupBox>

        <!-- 3. Save Destination Path -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Save To:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Width="60"/>
            <TextBox x:Name="SavePathTextBox" Grid.Row="0" Grid.Column="1" Padding="4,2" IsReadOnly="True" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
            <Button Content="Browse..." Grid.Row="0" Grid.Column="2" Padding="10,2" Click="BrowseButton_Click"/>

            <!-- Quick Location Buttons -->
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Quick: " VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondary}"/>
                <Button Content="Downloads" Padding="6,1" Margin="2,0" Click="QuickFolder_Click" Tag="Downloads"/>
                <Button Content="Videos" Padding="6,1" Margin="2,0" Click="QuickFolder_Click" Tag="Videos"/>
                <Button Content="Music" Padding="6,1" Margin="2,0" Click="QuickFolder_Click" Tag="Music"/>
                <Button Content="Desktop" Padding="6,1" Margin="2,0" Click="QuickFolder_Click" Tag="Desktop"/>
            </StackPanel>
        </Grid>

        <!-- 4. Footer Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="StartImmediatelyCheckBox" Content="Start download immediately" IsChecked="True" VerticalAlignment="Center"/>

            <Button x:Name="DownloadButton" Content="Download" IsDefault="True" Grid.Column="1" Width="85" Margin="0,0,6,0" IsEnabled="False" Click="DownloadButton_Click"/>
            <Button x:Name="QueueButton" Content="Add to Queue" Grid.Column="2" Width="90" Margin="0,0,6,0" IsEnabled="False" Click="QueueButton_Click"/>
            <Button Content="Cancel" IsCancel="True" Grid.Column="3" Width="75" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
