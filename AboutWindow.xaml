<Window x:Class="DOWN_MNG.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About NexLoad Pro" 
        Height="440" Width="530" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Brand -->
            <RowDefinition Height="*"/>    <!-- Info Content -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header / Brand -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0066CC" CornerRadius="6" Width="52" Height="52" Margin="0,0,14,0">
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="NexLoad Pro" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Next-Generation High-Speed Download Accelerator &amp; Cloud Media Grabber" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                <TextBlock Text="Version 1.0.0 (v1.00) — .NET 10.0 Windows" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Info Content (Native GroupBox) -->
        <GroupBox Grid.Row="1" Header="System &amp; Engine Specifications" Margin="0,0,0,14" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Developer:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="quietvow (github.com/quietvow/NexLoad)"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Core Acceleration:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="Multi-threaded Segmented Streams (Up to 32 parallel streams)"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cloud Hosters Engine:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="Pixeldrain, MEGA (AES-128 Decryption), MediaFire, GDrive"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Video Engine:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="Universal yt-dlp &amp; FFmpeg Muxer (1080p, 4K, MP3 Audio)"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Torrent Engine:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="MonoTorrent Client 3.0.2 (DHT &amp; Magnet Support)"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Operating System:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="OsVersionTextBlock" Grid.Column="1" Text="Microsoft Windows"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Process Architecture:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="ArchTextBlock" Grid.Column="1" Text="64-bit Process (x64)"/>
                    </Grid>

                    <Separator Margin="0,6,0,8"/>

                    <TextBlock Text="License: Open Source (MIT) — quietvow/NexLoad" FontSize="11" Foreground="#107C41" FontWeight="Bold"/>
                    <TextBlock Text="Built with native Windows desktop UX for maximum downloading performance." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- Action Buttons Footer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Check for Updates" Grid.Column="0" Padding="12,3" Click="CheckUpdates_Click"/>
            <Button Content="Copy System Info" Grid.Column="2" Padding="12,3" Margin="0,0,8,0" Click="CopyInfo_Click"/>
            <Button Content="Close" IsDefault="True" IsCancel="True" Grid.Column="3" Width="75" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
