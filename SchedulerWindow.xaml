<Window x:Class="DOWN_MNG.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Scheduler" 
        Icon="Resources/app.ico"
        Height="310" Width="480" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- Settings Body -->
            <RowDefinition Height="Auto"/> <!-- Buttons Row -->
        </Grid.RowDefinitions>

        <!-- Settings Body GroupBox -->
        <GroupBox Grid.Row="0" Header="Queue Scheduling" Margin="0,0,0,12" Padding="10">
            <StackPanel VerticalAlignment="Center">
                <CheckBox x:Name="EnabledCheckBox" 
                          Content="Enable Automated Queue Scheduling" 
                          FontWeight="Bold"
                          Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Start Time -->
                    <TextBlock Text="Start queue at:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox x:Name="StartTimeTextBox" Grid.Column="1" 
                             Width="90" HorizontalAlignment="Left"
                             Padding="4,2" Margin="0,0,0,8"/>

                    <!-- Stop Time -->
                    <TextBlock Text="Stop queue at:" Grid.Row="1" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1">
                        <TextBox x:Name="StopTimeTextBox" Width="90" Padding="4,2" Margin="0,0,8,0"/>
                        <CheckBox x:Name="StopOnTimeCheckBox" Content="Stop on time" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,4,0,8"/>

                <!-- Completion Action -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="On queue completion:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CompletionActionComboBox" Grid.Column="1">
                        <ComboBoxItem Content="Do nothing" Tag="None" IsSelected="True"/>
                        <ComboBoxItem Content="Close NexLoad application" Tag="CloseApp"/>
                        <ComboBoxItem Content="Shutdown Computer" Tag="ShutdownPC"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Buttons Row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Width="75" Margin="0,0,8,0" Click="SaveButton_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="75" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
