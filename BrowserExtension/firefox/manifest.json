{
  "manifest_version": 3,
  "name": "NexLoad Pro Browser Integration",
  "version": "1.0.0",
  "description": "High-Speed download capture and universal media grabber integration for NexLoad Pro.",
  "permissions": [
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3015/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nexload@quietvow.local",
      "strict_min_version": "109.0"
    }
  }
}
