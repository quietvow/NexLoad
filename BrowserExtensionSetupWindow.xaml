<Window x:Class="DOWN_MNG.BrowserExtensionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Extension Setup — 1-Click Integration" 
        Icon="Resources/app.ico"
        Height="540" Width="640" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header -->
            <RowDefinition Height="Auto"/> <!-- 1. Server Status Strip -->
            <RowDefinition Height="*"/>    <!-- 2. Browser Setup Options -->
            <RowDefinition Height="Auto"/> <!-- 3. Quick Steps Note -->
            <RowDefinition Height="Auto"/> <!-- 4. Action Footer -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource AccentPrimary}" Width="48" Height="48" CornerRadius="4" Margin="0,0,12,0">
                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Browser Extension Integration" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Enable automatic download interception and right-click grabbing in your web browser." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 1. Server Status Strip -->
        <Border Grid.Row="1" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" Padding="10,6" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ServerStatusIndicator" Text="●" Foreground="#107C41" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServerStatusTextBlock" Text="Local Communication Server: Online (Port 3015)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Test Connection" Padding="10,2" Click="TestConnection_Click"/>
            </Grid>
        </Border>

        <!-- 2. Browser Setup Options -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Google Chrome -->
            <GroupBox Grid.Row="0" Header="Google Chrome Integration" Margin="0,0,0,8" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chrome Browser" FontWeight="Bold"/>
                        <TextBlock x:Name="ChromeStatusText" Text="Ready for 1-click setup" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <Button Content="1-Click Setup Chrome" Grid.Column="1" Padding="12,4" FontWeight="SemiBold" Margin="0,0,6,0" Click="SetupChrome_Click"/>
                    <Button Content="Launch with Extension" Grid.Column="2" Padding="10,4" Click="LaunchChrome_Click"/>
                </Grid>
            </GroupBox>

            <!-- Microsoft Edge -->
            <GroupBox Grid.Row="1" Header="Microsoft Edge Integration" Margin="0,0,0,8" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Microsoft Edge" FontWeight="Bold"/>
                        <TextBlock x:Name="EdgeStatusText" Text="Ready for 1-click setup" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <Button Content="1-Click Setup Edge" Grid.Column="1" Padding="12,4" FontWeight="SemiBold" Margin="0,0,6,0" Click="SetupEdge_Click"/>
                    <Button Content="Launch with Extension" Grid.Column="2" Padding="10,4" Click="LaunchEdge_Click"/>
                </Grid>
            </GroupBox>

            <!-- Brave / Chromium -->
            <GroupBox Grid.Row="2" Header="Brave, Opera &amp; Other Chromium Browsers" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Other Chromium-based Browsers" FontWeight="Bold"/>
                        <TextBlock Text="Works on all Chromium browsers with Developer mode" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <Button Content="Setup Brave / Chromium" Grid.Column="1" Padding="12,4" Click="SetupBrave_Click"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 3. Quick Steps Note -->
        <Border Grid.Row="3" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" Padding="10,8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Simple 2-Step Setup (Folder path is copied automatically):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="1. Click '1-Click Setup' above. Your browser extensions page and the extension folder will open." FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="2. Turn ON the 'Developer mode' toggle (top-right in Chrome/Edge), click 'Load unpacked', and select this folder." FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <!-- 4. Action Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Copy Extension Path" Grid.Column="0" Padding="12,3" Margin="0,0,6,0" Click="CopyPath_Click"/>
            <Button Content="Open Extension Folder" Grid.Column="1" Padding="12,3" Click="OpenFolder_Click"/>
            <Button Content="Close" Grid.Column="3" Width="80" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
