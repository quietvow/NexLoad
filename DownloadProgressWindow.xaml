<Window x:Class="DOWN_MNG.DownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Progress" 
        Height="500" Width="600" 
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Tab Control Area -->
            <RowDefinition Height="Auto"/> <!-- Main Progress Bar -->
            <RowDefinition Height="Auto"/> <!-- Control Buttons Row -->
            <RowDefinition Height="Auto"/> <!-- Connection Header -->
            <RowDefinition Height="Auto"/> <!-- Segment Bar Visualizer -->
            <RowDefinition Height="*"/>    <!-- Connections Table Grid -->
        </Grid.RowDefinitions>

        <!-- 1. TABS AREA -->
        <TabControl Grid.Row="0" Margin="0,0,0,10">
            <TabItem Header="Download status">
                <!-- Info Inner Panel -->
                <Border BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" Background="{DynamicResource BgPanel}" Padding="10" Height="175">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- URL text box -->
                        <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" Padding="4,2" Margin="0,0,0,8">
                            <TextBlock x:Name="UrlTextBlock" 
                                       Text="https://download.example.com/file" 
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        
                        <!-- Details Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="StatusTextBlock" Grid.Row="0" Grid.Column="1" Text="Receiving data..." FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="File size:" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="SizeTextBlock" Grid.Row="1" Grid.Column="1" Text="-- MB"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Downloaded:" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="DownloadedTextBlock" Grid.Row="2" Grid.Column="1" Text="0 MB (0%)"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Transfer rate:" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="SpeedTextBlock" Grid.Row="3" Grid.Column="1" Text="-- MB/sec" FontWeight="Bold" Foreground="{DynamicResource StatusSuccess}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Time left:" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="TimeLeftTextBlock" Grid.Row="4" Grid.Column="1" Text="-- sec"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Resume capability:" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="ResumeCapabilityTextBlock" Grid.Row="5" Grid.Column="1" Text="Yes" FontWeight="Bold" Foreground="{DynamicResource StatusSuccess}"/>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Speed &amp; Streams">
                <Border BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" Background="{DynamicResource BgPanel}" Padding="12" Height="175">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Multi-Threaded Stream Engine: Active" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="High-speed dynamic segmentation divides downloads into parallel chunks for maximum throughput." Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Options on completion">
                <Border BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" Background="{DynamicResource BgPanel}" Padding="12" Height="175">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Post-Download Automation:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Automatic file integrity check and desktop notification enabled." Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 2. MAIN PROGRESS BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <ProgressBar x:Name="GlobalProgressBar" Height="18" Style="{DynamicResource IDMMainProgressBar}"/>
            <TextBlock x:Name="GlobalProgressText" Text="0%" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="11" 
                       Foreground="{DynamicResource TextPrimary}"/>
        </Grid>

        <!-- 3. CONTROL BUTTONS ROW -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="OpenFolderButton" Content="Open Folder" Grid.Column="0"
                    Padding="10,2" Click="OpenFolderButton_Click"/>
            
            <Button x:Name="PauseResumeButton" Content="Pause" Grid.Column="2"
                    Width="85" Margin="0,0,6,0" Click="PauseResumeButton_Click"/>
            
            <Button x:Name="CancelButton" Content="Cancel" Grid.Column="3"
                    Width="75" Click="CancelButton_Click"/>
        </Grid>

        <!-- 4. CONNECTION PROGRESS HEADER -->
        <TextBlock Grid.Row="3" Text="Start positions and download progress by connections:" 
                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Left" Margin="0,0,0,4"/>

        <!-- 5. SEGMENTED CONNECTION BAR -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" Height="18" Background="{DynamicResource BgPanel}" Margin="0,0,0,8">
            <ItemsControl x:Name="ChunksItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8" Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" 
                                     Style="{DynamicResource IDMConnectionProgressBar}" 
                                     Margin="0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 6. DETAILED CONNECTIONS TABLE -->
        <ListView x:Name="ConnectionsListView" Grid.Row="5" Height="120" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="N." DisplayMemberBinding="{Binding DisplayId}" Width="35"/>
                    <GridViewColumn Header="Downloaded" DisplayMemberBinding="{Binding DisplayDownloaded}" Width="140"/>
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding DisplayInfo}" Width="360"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
